FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///medikiosk.db
# DATABASE_URL=postgresql://medikiosk:medikiosk@localhost:5432/medikiosk

AI_PROVIDER=mock
OPENAI_API_KEY=
